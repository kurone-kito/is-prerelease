{
  "name": "@kurone-kito/is-prerelease",
  "version": "0.1.0",
  "description": "The simple CLI app based on Node.js that determines whether the project is a pre-release version",
  "keywords": [
    "check",
    "ci-cd",
    "cli",
    "cli-app",
    "determine",
    "prerelease",
    "semver",
    "utility",
    "version"
  ],
  "homepage": "https://github.com/kurone-kito/is-prerelease#readme",
  "bugs": "https://github.com/kurone-kito/is-prerelease/issues",
  "repository": "github:kurone-kito/is-prerelease",
  "license": "MIT",
  "author": "kurone-kito <krone@kit.black> (https://kit.black/)",
  "type": "module",
  "bin": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "bin": "node ./dist/index.mjs",
    "build": "vite build",
    "clean": "rimraf -g \"*.tgz\" \"*.tsbuildinfo\" coverage dist node_modules/.cache",
    "dev": "vite build --watch",
    "is:prerelease": "pnpm run bin $(npm pkg get version) pre",
    "is:release": "pnpm run bin $(npm pkg get version)",
    "lint": "pnpm run --stream \"/lint:check:.+/\"",
    "lint:check:biome": "biome check",
    "lint:check:cspell": "cspell lint --no-progress --show-suggestions -u \"./**/*\"",
    "lint:check:markdown": "markdownlint-cli2 \"**/*.md\"",
    "lint:fix": "pnpm run --stream \"/(lint:fix:.+|lint:check:cspell)/\"",
    "lint:fix:biome": "biome check --write",
    "lint:fix:markdown": "markdownlint-cli2 --fix \"**/*.md\"",
    "pnpm:devPreinstall": "pnpm dlx mkdirp dist && pnpm dlx shx head -n 1 src/index.mts > dist/index.mjs",
    "prepack": "pnpm run rebuild",
    "prepare": "husky",
    "rebuild": "pnpm run clean && pnpm run build",
    "test": "pnpm run \"/test:.+/\"",
    "test:ts": "tsc -p tsconfig.test.json",
    "test:vitest": "vitest run --coverage"
  },
  "dependencies": {
    "@kurone-kito/web-toybox-node": "^0.1.0-alpha.11",
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@cspell/cspell-types": "^10.3.0",
    "@kurone-kito/biome-config": "^0.23.0",
    "@kurone-kito/commitlint-config": "^0.23.0",
    "@kurone-kito/cspell-config": "^0.23.0",
    "@kurone-kito/lint-staged-config": "^0.23.0",
    "@kurone-kito/markdownlint-config": "^0.23.0",
    "@kurone-kito/typescript-config": "^0.22.0",
    "@kurone-kito/vite-lib-config": "^0.22.0",
    "@types/semver": "^7.7.1",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^4.0.18",
    "cspell": "^10.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "markdownlint-cli2": "^0.23.2",
    "rimraf": "^6.1.3",
    "typescript": "~7.0.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@12.4.0+sha512.37536c26ed40ab4134b6511e09f6b27f3ebb45687468f2406ca3805279a4e5ca158c1931350ad9774d6ab2108d71b3dbaeb39943159294375e4d053e8e05685c",
  "engines": {
    "node": "^22.23.2 || ^24.2.0 || >=26.0.0",
    "pnpm": "^12.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
