{
  "name": "@kurone-kito/is-prerelease",
  "version": "0.1.0",
  "description": "The simple CLI app based on Node.js that determines whether the project is a pre-release version",
  "keywords": [
    "check",
    "ci-cd",
    "cli",
    "cli-app",
    "determine",
    "prerelease",
    "semver",
    "utility",
    "version"
  ],
  "homepage": "https://github.com/kurone-kito/is-prerelease#readme",
  "bugs": "https://github.com/kurone-kito/is-prerelease/issues",
  "repository": "github:kurone-kito/is-prerelease",
  "license": "MIT",
  "author": "kurone-kito <krone@kit.black> (https://kit.black/)",
  "type": "module",
  "bin": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf -g \"*.tgz\" \"*.tsbuildinfo\" coverage dist node_modules/.cache",
    "dev": "tsc --watch",
    "lint": "pnpm run \"/lint:.+:check/\"",
    "lint:biome:check": "biome check",
    "lint:biome:fix": "biome check --write",
    "lint:cspell:check": "cspell lint --no-progress --show-suggestions -u \"./**/*\"",
    "lint:fix": "pnpm run \"/lint:.+:fix/\"",
    "lint:markdown:check": "markdownlint-cli2 \"**/*.md\"",
    "lint:markdown:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "pnpm:devPreinstall": "pnpm dlx mkdirp dist && pnpm dlx shx head -n 1 src/index.mts > dist/index.mjs",
    "postlint:fix": "pnpm run lint:cspell:check",
    "prepack": "pnpm run rebuild",
    "prepare": "pnpm dlx which -s husky && husky || true",
    "rebuild": "pnpm run clean && pnpm run build",
    "test": "pnpm run \"/test:.+/\"",
    "test:ts": "tsc --noEmit",
    "test:vitest": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@cspell/cspell-types": "^9.6.0",
    "@kurone-kito/biome-config": "^0.22.0-alpha.4",
    "@kurone-kito/commitlint-config": "^0.22.0-alpha.4",
    "@kurone-kito/cspell-config": "^0.22.0-alpha.4",
    "@kurone-kito/lint-staged-config": "^0.22.0-alpha.4",
    "@kurone-kito/markdownlint-config": "^0.22.0-alpha.4",
    "@kurone-kito/typescript-config": "^0.22.0-alpha.4",
    "@vitest/coverage-v8": "^4.0.18",
    "cspell": "^9.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "markdownlint-cli2": "^0.20.0",
    "rimraf": "^6.1.2",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316",
  "engines": {
    "node": "^20.11 || ^22 || >=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
